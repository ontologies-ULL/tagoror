<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.ull.es/iis/simulation/ontologies/chocolate-soldier#"
     xml:base="http://www.ull.es/iis/simulation/ontologies/chocolate-soldier"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#">
    
    <owl:Ontology rdf:about="http://www.ull.es/iis/simulation/ontologies/chocolate-soldier"/>

    <owl:Class rdf:about="#Soldado">
        <owl:disjointWith rdf:resource="#Alimento"/>
    </owl:Class>
    
    <owl:Class rdf:about="#Alimento"/>
    
    <owl:Class rdf:about="#Chocolate">
        <rdfs:subClassOf rdf:resource="#Alimento"/>
    </owl:Class>

    <owl:ObjectProperty rdf:about="#consume">
        <rdfs:domain rdf:resource="#Soldado"/>
        <rdfs:range rdf:resource="#Alimento"/>
    </owl:ObjectProperty>

    <owl:DatatypeProperty rdf:about="#nivelDeLocura">
        <rdfs:domain rdf:resource="#Soldado"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#tiempoEnTrinchera">
        <rdfs:domain rdf:resource="#Soldado"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>

    <owl:NamedIndividual rdf:about="#Barra_Chocolate_Negro">
        <rdf:type rdf:resource="#Chocolate"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#Barra_Chocolate_Canibal">
        <rdf:type rdf:resource="#Chocolate"/>
        <consume rdf:resource="#Soldado_Queek"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#Chocolate_Rancio">
        <rdf:type rdf:resource="#Chocolate"/>
        <nivelDeLocura rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">99</nivelDeLocura>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#Soldado_Queek">
        <rdf:type rdf:resource="#Soldado"/>
        <tiempoEnTrinchera rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Muchos-muchos días con frío</tiempoEnTrinchera>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#Soldado_De_Cacao">
        <rdf:type rdf:resource="#Soldado"/>
        <rdf:type rdf:resource="#Chocolate"/>
    </owl:NamedIndividual>

</rdf:RDF>
