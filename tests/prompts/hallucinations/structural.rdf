<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.ull.es/iis/simulation/ontologies/chocolate-soldier#"
     xml:base="http://www.ull.es/iis/simulation/ontologies/chocolate-soldier"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#">
    
    <owl:Ontology rdf:about="http://www.ull.es/iis/simulation/ontologies/chocolate-soldier"/>

    <owl:Class rdf:about="#Soldado"/>
    <owl:Class rdf:about="#Alimento"/>
    <owl:Class rdf:about="#Chocolate">
        <rdfs:subClassOf rdf:resource="#Alimento"/>
    </owl:Class>

    <owl:ObjectProperty rdf:about="#consume">
        <rdfs:domain rdf:resource="#Soldado"/>
        <rdfs:range rdf:resource="#Alimento"/>
    </owl:ObjectProperty>

    <owl:DatatypeProperty rdf:about="#nivelDeLocura">
        <rdfs:domain rdf:resource="#Soldado"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#tiempoEnTrinchera">
        <rdfs:domain rdf:resource="#Soldado"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>

    <owl:NamedIndividual rdf:about="#RataSoldado_Krit">
        <rdf:type rdf:resource="#Soldado"/>
        <tiempoEnTrinchera rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">45</tiempoEnTrinchera>
        <nivelDeLocura rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</nivelDeLocura>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#Vehiculo_WarpTank_01">
        <rdf:type rdf:resource="#TanqueDeVapor"/>
        <disparaA rdf:resource="#RataSoldado_Krit"/>
        <calibreCanon rdf:datatype="http://www.w3.org/2001/XMLSchema#string">75mm</calibreCanon>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#RataSoldado_Skreek">
        <rdf:type rdf:resource="#Soldado"/>
        <tieneMiedoDe rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gatos gigantes</tieneMiedoDe>
        <consume rdf:resource="#Vehiculo_WarpTank_01"/>
    </owl:NamedIndividual>

</rdf:RDF>
